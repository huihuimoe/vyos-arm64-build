     exit 1
 }
 
+# ARM64 kernel packages contain a gzip-compressed EFI Image. sbsign needs
+# the uncompressed PE image; leave unsigned builds unchanged.
+prepare_kernel_image() {
+    if [ "$(dpkg --print-architecture)" = "arm64" ] && gzip -t /boot/${VMLINUZ} 2>/dev/null; then
+        echo "I: Decompressing ARM64 Linux Kernel for Secure Boot"
+        gzip -dc /boot/${VMLINUZ} > /boot/${VMLINUZ}.tmp
+        if [ $? -ne 0 ]; then
+            hsm_sign_failed "Decompression of ARM64 Linux Kernel failed"
+        fi
+        mv /boot/${VMLINUZ}.tmp /boot/${VMLINUZ}
+    fi
+}
+
 # All Linux Kernel modules need to be cryptographically signed
 find /lib/modules -type f -name \*.ko | while read MODULE; do
     modinfo ${MODULE} | grep -q "signer:"
